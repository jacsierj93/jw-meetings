    {
      "id": "0676423c-f98e-469e-b887-d8da19e6fc41",
      "text": "Toda regla, restriccion, preferencia, excepcion o criterio de rotacion confirmado por el usuario debe persistirse durante la misma conversacion y consultarse al iniciar futuras tareas operativas.",
      "category": "persistence_policy",
      "scope": "global",
      "person_name": null,
      "effective_from": null,
      "effective_to": null,
      "status": "superseded",
      "source": "user",
      "created_at": "2026-06-23T00:11:06.312822Z",
      "updated_at": "2026-06-23T00:14:01.627491Z",
      "metadata": {
